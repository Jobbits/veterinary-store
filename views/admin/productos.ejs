<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestión de Productos</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<%- include('../partials/navbar') %>
<body>
  <div class="container">
    <h1 class="mt-5 text-center">Gestión de Productos</h1>
    <div class="d-flex justify-content-center mb-3">
      <a href="/admin/nuevo-producto" class="btn btn-primary">Nuevo Producto</a>
    </div>
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Nombre</th>
          <th>Descripción</th>
          <th>Precio</th>
          <th>Stock</th>
          <th>Categoría</th>
          <th>Imagen</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% productos.forEach(producto => { %>
          <tr>
            <td><%= producto.nombre %></td>
            <td><%= producto.descripcion %></td>
            <td><%= producto.precio %></td>
            <td><%= producto.stock %></td>
            <td><%= producto.categoria %></td>
            <td><img src="<%= producto.imagen %>" alt="<%= producto.nombre %>" style="max-width: 100px; max-height: 100px;"></td>
            <td>
              <a href="/admin/editar-producto/<%= producto._id %>" class="btn btn-warning btn-sm">Editar</a>
              <form action="/admin/eliminar-producto/<%= producto._id %>" method="POST" class="d-inline">
                <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%- include('../partials/footer') %>
</body>

</html>
